# Makefile for WALKER with MinGW (32-bit gcc): Walker.exe and the game modules (QVM).
#
# Windows (from the "code" directory, 32-bit MinGW in PATH):
#   mingw32-make -f Makefile.mingw          Walker.exe + QVM (target all)
#   mingw32-make -f Makefile.mingw engine   Walker.exe only
#   mingw32-make -f Makefile.mingw qvm      QVM only (see Makefile.qvm)
#   mingw32-make -f Makefile.mingw clean
#
# Cross compile on Linux:
#   make -f Makefile.mingw CC=i686-w64-mingw32-gcc WINDRES=i686-w64-mingw32-windres
#
# Result: a ready game folder ../walker/dist:
#   Walker.exe, basewalker/pak0.pk3, basewalker/wk_islands.pk3, basewalker/vm/*.qvm
#
# Notes:
#  - the compiler must produce 32-bit code (i686); the engine is not 64-bit clean
#  - vm_x86.c is not built: its code generator uses MSVC or Linux gcc assembler,
#    so this build runs game QVMs in the interpreter (NO_VM_COMPILED)

ifeq ($(OS),Windows_NT)
SHELL = cmd.exe
endif

ifeq ($(origin CC),default)
CC = gcc
endif
WINDRES ?= windres

BUILD_DIR = build-mingw
TARGET = ../walker/dist/Walker.exe

WARNINGS ?= -w
CFLAGS = -O2 -fno-strict-aliasing -fcommon $(WARNINGS) \
	-DWIN32 -D_WINDOWS -DNDEBUG -DNO_VM_COMPILED
LDFLAGS = -mwindows -static-libgcc -s
LIBS = -lwinmm -lwsock32 -lgdi32 -lole32 -lm

CLIENT_SRC = cl_bench.c cl_cgame.c cl_cin.c cl_console.c cl_input.c cl_keys.c cl_main.c \
	cl_net_chan.c cl_parse.c cl_scrn.c cl_ui.c snd_adpcm.c snd_dma.c snd_mem.c \
	snd_mix.c snd_wavelet.c

QCOMMON_SRC = cm_load.c cm_patch.c cm_polylib.c cm_test.c cm_trace.c cmd.c \
	common.c cvar.c files.c huffman.c md4.c msg.c net_chan.c unzip.c vm.c \
	vm_interpreted.c

GAME_SRC = q_math.c q_shared.c

SERVER_SRC = sv_bot.c sv_ccmds.c sv_client.c sv_game.c sv_init.c sv_main.c \
	sv_net_chan.c sv_snapshot.c sv_world.c

WIN32_SRC = win_sysinfo.c win_input.c win_main.c win_net.c win_shared.c win_snd.c win_syscon.c \
	win_wndproc.c win_gamma.c win_glimp.c win_qgl.c

RENDERER_SRC = tr_animation.c tr_backend.c tr_bsp.c tr_cmds.c tr_curve.c \
	tr_flares.c tr_font.c tr_glsl.c tr_vbo.c tr_image.c tr_init.c tr_light.c tr_main.c tr_marks.c \
	tr_mesh.c tr_model.c tr_model_glb.c tr_noise.c tr_scene.c tr_shade.c \
	tr_shade_calc.c tr_shader.c tr_shadows.c tr_sunshadow.c tr_sky.c tr_surface.c tr_world.c

JPEG_SRC = jcapimin.c jccoefct.c jccolor.c jcdctmgr.c jchuff.c jcinit.c \
	jcmainct.c jcmarker.c jcmaster.c jcomapi.c jcparam.c jcphuff.c jcprepct.c \
	jcsample.c jctrans.c jdapimin.c jdapistd.c jdatadst.c jdatasrc.c jdcoefct.c \
	jdcolor.c jddctmgr.c jdhuff.c jdinput.c jdmainct.c jdmarker.c jdmaster.c \
	jdpostct.c jdsample.c jdtrans.c jerror.c jfdctflt.c jidctflt.c jmemmgr.c \
	jmemnobs.c jutils.c

BOTLIB_SRC = be_aas_bspq3.c be_aas_cluster.c be_aas_debug.c be_aas_entity.c \
	be_aas_file.c be_aas_main.c be_aas_move.c be_aas_optimize.c be_aas_reach.c \
	be_aas_route.c be_aas_routealt.c be_aas_sample.c be_ai_char.c be_ai_chat.c \
	be_ai_gen.c be_ai_goal.c be_ai_move.c be_ai_weap.c be_ai_weight.c be_ea.c \
	be_interface.c l_crc.c l_libvar.c l_log.c l_memory.c l_precomp.c l_script.c \
	l_struct.c

vpath %.c client qcommon game server win32 renderer jpeg-6 botlib

ENGINE_SRC = $(CLIENT_SRC) $(QCOMMON_SRC) $(GAME_SRC) $(SERVER_SRC) $(WIN32_SRC) \
	$(RENDERER_SRC) $(JPEG_SRC)
ENGINE_OBJS = $(addprefix $(BUILD_DIR)/,$(ENGINE_SRC:.c=.o))
BOTLIB_OBJS = $(addprefix $(BUILD_DIR)/,$(BOTLIB_SRC:.c=.o))
RES = $(BUILD_DIR)/winquake.res

$(BOTLIB_OBJS): CFLAGS += -DBOTLIB

all: engine qvm

engine: $(TARGET)

qvm:
	$(MAKE) -f Makefile.qvm

# any header change rebuilds everything: slower, but never leaves stale objects
HEADERS = $(wildcard */*.h)

$(TARGET): $(ENGINE_OBJS) $(BOTLIB_OBJS) $(RES)
	$(CC) $(LDFLAGS) -o $@ $(ENGINE_OBJS) $(BOTLIB_OBJS) $(RES) $(LIBS)

$(BUILD_DIR)/%.o: %.c $(HEADERS) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(RES): win32/winquake.rc | $(BUILD_DIR)
	$(WINDRES) --include-dir=win32 -O coff win32/winquake.rc -o $@

$(BUILD_DIR):
	-mkdir $(BUILD_DIR)

ifeq ($(OS),Windows_NT)
clean:
	-if exist $(BUILD_DIR) rmdir /s /q $(BUILD_DIR)
	-del /q ..\walker\dist\Walker.exe 2>nul
	$(MAKE) -f Makefile.qvm clean
else
clean:
	-rm -rf $(BUILD_DIR) $(TARGET)
	$(MAKE) -f Makefile.qvm clean
endif

.PHONY: all engine qvm clean
